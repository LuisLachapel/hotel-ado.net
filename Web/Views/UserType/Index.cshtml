@{
    ViewBag.Title = "Index";
}



<h1>Tipo Usuarios</h1>

<!--Formulario-->

<fieldset class="container mb-4" style="border: 1px solid black;">
  <legend style="font-size: 14px;">Datos de tipo usuario</legend>

  <form id="formUserType" method="post" enctype="multipart/form-data">
     <div class="row">
            <!--Campo para id-->
            <div class="mb-3 col-md-6">
               <label for="formId" class="form-label">Id</label>
               <input type="number" class="form-control" id="formId" aria-describedby="" name="id" value="0" readonly>
            </div>

            <!--Campo para nombre-->
            <div class="mb-3 col-md-6">
               <label for="formName" class="form-label">Nombre</label>
               <input type="text" class="form-control" id="formName" name="name" required maxlength="20" aria-describedby="">
            </div>

        </div>


                <!-- Tabla de parámetros con checkbox -->
        <div class="container mt-4">
          <h5>Seleccionar Parámetros</h5>
          <table class="table table-bordered" id="tablePageData">
            <thead>
              <tr>
                <th>Seleccionar</th>
                <th>ID</th>
                <th>Mensaje</th>
              </tr>
            </thead>
            <tbody>
              <!-- Se llenará con JS -->
            </tbody>
          </table>
        </div>



                <!--Campo para descripcion-->
        <div class="mb-3">
           <label for="formDescription" class="form-label">Descripción</label>
           <textarea class="form-control" id="formDescription" name="description" rows="5" cols="20" required maxlength="50"></textarea>
        </div>

    

        <div class="mb-3"> 
            <button type="button" class="btn btn-primary" onclick="SaveData()">Aceptar</button>
            <button type="button" class="btn btn-danger" onclick="Clear()">Limpiar</button>
        </div>
  </form>
</fieldset>


<!--Div para el combobox de marca-->
<div class="input-group mb-3">
    <select class="form-control" id="selectUserType" onchange="searchByUserType()"></select>
    <button class="btn btn-outline-secondary" type="button" onclick="searchByUserType()">Buscar</button>
</div>

<!-- Div exclusivo para la tabla -->
<div id="table-UserType"></div>

<script src="~/Scripts/generic.js"></script>
<script src="~/Scripts/UserType/UserType.js"></script>


