@{
    ViewBag.Title = "Index";
}



<h1>Tipo Usuarios</h1>

<!--Formulario-->

<fieldset class="container mb-4" style="border: 1px solid black;">
  <legend style="font-size: 14px;">Datos de la persona</legend>

  <form id="formUserType" method="post" enctype="multipart/form-data">
     <div class="row">
            <!--Campo para id-->
            <div class="mb-3 col-md-6">
               <label for="formId" class="form-label">Id</label>
               <input type="number" class="form-control" id="formId" aria-describedby="" name="id" value="0" readonly>
            </div>

            <!--Campo para nombre-->
            <div class="mb-3 col-md-6">
               <label for="formName" class="form-label">Nombre</label>
               <input type="text" class="form-control" id="formName" name="name" required maxlength="20" aria-describedby="">
            </div>

        </div>



        <div class="row">
            <!--Campo para precio y numero de personas-->
            <div class="mb-3 col-md-6">
               <label for="formPriceByNight" class="form-label">Precio por noche</label>
               <input type="number" class="form-control" id="formPriceByNight" aria-describedby="" name="priceByNight">
            </div>

            <div class="mb-3 col-md-6">
               <label for="formNumberOfPeople" class="form-label">Numero de personas</label>
               <input type="number" class="form-control" id="formNumberOfPeople" aria-describedby="" name="numberOfPeople" inputmode="numeric", min="0">
            </div>

        </div>

        <!-- Radio buttons -->
    <div class="row">
      <!-- Tiene piscina -->
      <div class="mb-3 col-md-4">
        <label class="form-label">Tiene Piscina</label>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="hasPool" id="RadioPoolYes" value="1">
            <label class="form-check-label" for="RadioPoolYes">Si</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="hasPool" id="RadioPoolNo" value="0">
            <label class="form-check-label" for="RadioPoolNo">No</label>
          </div>
        </div>
      </div>

      <!-- Tiene vista al mar -->
      <div class="mb-3 col-md-4">
        <label class="form-label">Tiene vista al mar</label>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="hasSeaView" id="hasSeaViewYes" value="1">
            <label class="form-check-label" for="hasSeaViewYes">Si</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="hasSeaView" id="hasSeaViewNo" value="0">
            <label class="form-check-label" for="hasSeaViewNo">No</label>
          </div>
        </div>
      </div>

      <!-- Tiene Wifi -->
      <div class="mb-3 col-md-4">
        <label class="form-label">Tiene Wifi</label>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="hasWifi" id="hasWifiYes" value="1">
            <label class="form-check-label" for="hasWifiYes">Si</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="hasWifi" id="hasWifiNo" value="0">
            <label class="form-check-label" for="hasWifiNo">No</label>
          </div>
        </div>
      </div>
    </div>



                <!--Campo para descripcion-->
        <div class="mb-3">
           <label for="formDescription" class="form-label">Descripción</label>
           <textarea class="form-control" id="formDescription" name="description" rows="5" cols="20" required maxlength="50"></textarea>
        </div>

    

        <div class="mb-3"> 
            <button type="button" class="btn btn-primary" onclick="SaveData()">Aceptar</button>
            <button type="button" class="btn btn-danger" onclick="Clear()">Limpiar</button>
        </div>
  </form>
</fieldset>


<!--Div para el combobox de marca-->
<div class="input-group mb-3">
    <select class="form-control" id="selectUserType" onchange="searchByUserType()"></select>
    <button class="btn btn-outline-secondary" type="button" onclick="searchByUserType()">Buscar</button>
</div>

<!-- Div exclusivo para la tabla -->
<div id="table-UserType"></div>

<script src="~/Scripts/generic.js"></script>
<script src="~/Scripts/UserType/UserType.js"></script>


